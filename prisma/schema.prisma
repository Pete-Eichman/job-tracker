generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]
  resumes       Resume[]
  createdAt     DateTime  @default(now())
}

model Resume {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  rawText      String
  fileUrl      String?
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  matches      Match[]
  coverLetters CoverLetter[]

  @@index([userId])
}

model Job {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceUrl        String?
  rawText          String
  title            String
  company          String
  location         String?
  workMode         WorkMode?
  salaryMin        Decimal?  @db.Decimal(12, 2)
  salaryMax        Decimal?  @db.Decimal(12, 2)
  salaryCurrency   String?
  seniority        String?
  requiredSkills   String[]
  niceToHaveSkills String[]
  responsibilities String[]
  status           JobStatus     @default(SAVED)
  notes            String?
  appliedAt        DateTime?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  matches          Match[]
  coverLetters    CoverLetter[]
  aiUsage          AiUsage[]

  @@index([userId, status])
  @@index([userId, archivedAt])
}

model Match {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  score     Int
  reasoning String
  gaps      String[]
  strengths String[]
  createdAt DateTime @default(now())

  @@unique([jobId, resumeId])
}

model CoverLetter {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId  String?
  // SetNull (not Cascade): cover letters are user-authored content kept as a
  // historical record even when the source resume is deleted.
  resume    Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  draft     String
  createdAt DateTime @default(now())

  @@index([resumeId])
}

model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  jobId        String?
  // SetNull (not Cascade): AI usage records are kept for billing/audit history
  // even when the associated job is deleted.
  job          Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  operation    String
  model        String
  inputTokens  Int
  outputTokens Int
  costCents    Int
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([jobId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum JobStatus {
  SAVED
  APPLIED
  PHONE_SCREEN
  TECHNICAL
  ONSITE
  OFFER
  REJECTED
  WITHDRAWN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}